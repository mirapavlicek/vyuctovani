# Příklad pro nginx (reverzní proxy na stejném serveru).
# /etc/nginx/sites-available/vyuctovani  ->  ln -s do sites-enabled, pak: nginx -t && systemctl reload nginx
# HTTPS certifikát např.: certbot --nginx -d vyuctovani.example.cz

server {
    listen 80;
    server_name vyuctovani.example.cz;

    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }
}

# Caddy (alternativa, HTTPS automaticky):
#   vyuctovani.example.cz {
#       reverse_proxy 127.0.0.1:3000
#   }
